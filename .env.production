# Variables d'environnement de production
ENVIRONMENT=production
DEBUG=0

# Configuration base de données
DATABASE_URL=postgresql://user:password@localhost:5432/eazzycalculator_prod

# Sécurité
SECRET_KEY=votre_clé_secrète_très_longue_et_aléatoire
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=https://eazzycalculator.com,https://www.eazzycalculator.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Monitoring
SENTRY_DSN=votre_dsn_sentry

# Backup
BACKUP_PATH=/path/to/backups
BACKUP_RETENTION_DAYS=30

# SSL/TLS
SSL_CERTFILE=/path/to/cert.pem
SSL_KEYFILE=/path/to/key.pem

# Cache
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/eazzycalculator/app.log
